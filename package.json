{
  "name": "cs-study-group-tutoring-finder",
  "version": "1.0.0",
  "description": "The problem: Students studying for the same module often don't know classmates nearby who'd be willing to  form a study group, especially in large first-year classes.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue.bold,cyan.bold\" \"npm run server\" \"npm run client\"",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue.bold,cyan.bold\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server start",
    "client": "npm --prefix client/my-app run dev",
    "build": "npm --prefix client/my-app run build",
    "test": "node server/test_runner.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConstantPeach14/CS-Study-Group-Tutoring-Finder.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ConstantPeach14/CS-Study-Group-Tutoring-Finder/issues"
  },
  "homepage": "https://github.com/ConstantPeach14/CS-Study-Group-Tutoring-Finder#readme",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
